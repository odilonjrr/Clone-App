# ─── Banco ───────────────────────────────────────────────
# Produção: string de conexão do Postgres (Supabase: Project Settings → Database →
# Connection string → "Transaction pooler", porta 6543).
# Sem esta variável, o app usa um banco local (PGlite) em .data/ — só para desenvolvimento.
DATABASE_URL=

# ─── Endereço público do app (usado nos links de rastreio e do motoboy) ───
APP_URL=http://localhost:3100

# ─── Criação da primeira conta do painel ──────────────────
# Se definido, o formulário de criar conta pede este código.
SETUP_CODE=

# ─── Pagamento online (Pix) ───────────────────────────────
# mock  = modo teste: Pix fictício com botão "Simular pagamento"
# asaas = Asaas (use a chave do SANDBOX para testar)
PAYMENT_PROVIDER=mock
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# Token que você define no painel do Asaas ao cadastrar o webhook; o Asaas o envia no
# cabeçalho asaas-access-token.
ASAAS_WEBHOOK_TOKEN=

# ─── WhatsApp (API oficial da Meta, WhatsApp Cloud API) ─────
# Sem estas variáveis, as mensagens ficam em "modo manual": o painel mostra um botão
# que abre o WhatsApp com o texto pronto.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=pt_BR

# ─── E-mail (recuperação de senha do painel), via Resend ───
RESEND_API_KEY=
EMAIL_FROM="Delisys <nao-responda@seudominio.com.br>"

# ─── Limpeza diária (Vercel Cron) ─────────────────────────
# Defina qualquer texto longo e aleatório; a Vercel o envia ao chamar /api/cron/limpeza.
CRON_SECRET=

# ─── Política de privacidade (/privacidade) ────────────────
LEGAL_NAME=
LEGAL_DOCUMENT=
PRIVACY_EMAIL=
